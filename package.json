{
  "name": "wowkit",
  "version": "0.1.0",
  "description": "Packages for World of Warcraft: Forever addons written in TypeScript (compiled to Lua with TypeScriptToLua), and the addons built with them",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vattiss/wowkit.git"
  },
  "author": "Attila Varga (https://github.com/vattiss)",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.14.0",
  "wowUiSource": {
    "repository": "https://github.com/Gethe/wow-ui-source.git",
    "branch": "forever",
    "commit": "b401e0332adfbf0460d319b06d8ea29279a941f1"
  },
  "scripts": {
    "fetch:wow-ui": "node scripts/fetch-wow-ui-source.ts",
    "fetch:wow-ui:latest": "node scripts/fetch-wow-ui-source.ts --latest",
    "gen:types": "node scripts/generate-wow-types.ts",
    "build": "pnpm -r --workspace-concurrency=1 build",
    "build:tests": "pnpm -r --workspace-concurrency=1 build:tests",
    "typecheck": "pnpm -r typecheck && tsc -p tsconfig.scripts.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check": "node scripts/check-boundary.ts && node scripts/check-layers.ts && node scripts/check-wiring.ts && node scripts/check-names.ts && eslint . && prettier --check .",
    "test": "pnpm check && pnpm build && pnpm build:tests && pnpm -r --workspace-concurrency=1 test:run"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/luaparse": "^0.2.13",
    "@types/node": "^26.6.5",
    "@types/pngjs": "^6.0.5",
    "@typescript-to-lua/language-extensions": "^1.19.0",
    "eslint": "^10.13.0",
    "lua-types": "^2.14.1",
    "luaparse": "^0.3.1",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.10",
    "typescript": "6.0.2",
    "typescript-eslint": "^8.71.2",
    "typescript-to-lua": "^1.37.1"
  }
}
