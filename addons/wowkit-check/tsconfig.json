{
  // The addon: compiled to a single Lua file by TypeScriptToLua, together with the packages it uses
  // (@wowkit/core and @wowkit/wow are compiled from their sources, see "paths").
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["lua-types/5.1", "@typescript-to-lua/language-extensions"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    // Services use method decorators (packages/@wowkit/core)
    "experimentalDecorators": true,
    "paths": {
      "@wowkit/core": ["../../packages/@wowkit/core/src/index.ts"],
      // The sources of a package by file name: for `declare module` blocks that add an event
      "@wowkit/core/*": ["../../packages/@wowkit/core/src/*"],
      "@wowkit/wow": ["../../packages/@wowkit/wow/src/index.ts"],
      "@wowkit/ui": ["../../packages/@wowkit/ui/src/index.ts"],
      "@wowkit/wow-data": ["../../packages/@wowkit/wow-data/src/index.ts"]
    },
    "rootDir": "../..",
    "outDir": "dist/WowkitCheck"
  },
  "include": [
    "src/**/*.ts",
    "../../packages/@wowkit/core/src/**/*.ts",
    "../../packages/@wowkit/wow/src/**/*.ts",
    "../../packages/@wowkit/ui/src/**/*.ts",
    "../../packages/@wowkit/wow-data/src/**/*.ts",
    "../../packages/@wowkit/wow-types/**/*.d.ts"
  ],
  "tstl": {
    // WoW embeds Lua 5.1
    "luaTarget": "5.1",
    // One self-contained file; WoW has no `require`
    "luaBundle": "WowkitCheck.lua",
    "luaBundleEntry": "src/main.ts",
    "luaLibImport": "require-minimal",
    // Plain functions do not take a hidden `self`; methods of interfaces/classes still do (`:` calls)
    "noImplicitSelf": true,
    "noHeader": true
  }
}
