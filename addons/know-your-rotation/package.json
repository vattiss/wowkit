{
  "name": "@forever-reminders/know-your-rotation",
  "version": "1.0.0",
  "description": "World of Warcraft: Forever addon that lights up the next spell to press on your action bars, plus heals, defense, interrupts, purges, cleanses and totems",
  "private": true,
  "license": "MIT",
  "addon": {
    "name": "KnowYourRotation"
  },
  "scripts": {
    "build": "tstl -p tsconfig.json && node ../../scripts/package-addon.ts",
    "watch": "node ../../scripts/package-addon.ts && tstl -p tsconfig.json --watch",
    "build:tests": "tstl -p tsconfig.test.json",
    "test:run": "node ../../scripts/smoke-test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "deploy:game": "pnpm build && node ../../scripts/deploy.ts",
    "zip": "pnpm build && node ../../scripts/zip-addon.ts"
  },
  "dependencies": {
    "@forever-reminders/shared": "workspace:*",
    "@wowkit/core": "workspace:*",
    "@wowkit/ui": "workspace:*",
    "@wowkit/wow": "workspace:*",
    "@wowkit/wow-data": "workspace:*"
  },
  "devDependencies": {
    "@wowkit/test-kit": "workspace:*",
    "@wowkit/wow-types": "workspace:*"
  }
}
