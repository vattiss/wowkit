{
  "name": "forever-reminders",
  "version": "0.1.0",
  "description": "World of Warcraft: Forever addon reminding of missing buffs, weapon buffs, spells missing from the action bars and outdated spell ranks",
  "private": true,
  "license": "ISC",
  "addon": {
    "name": "ForeverReminders"
  },
  "scripts": {
    "build": "tstl -p tsconfig.json && node ../../scripts/package-addon.ts",
    "watch": "node ../../scripts/package-addon.ts && tstl -p tsconfig.json --watch",
    "build:tests": "tstl -p tsconfig.test.json",
    "test:run": "node ../../scripts/smoke-test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "deploy:game": "pnpm build && node ../../scripts/deploy.ts"
  },
  "dependencies": {
    "@forever/framework": "workspace:*",
    "@forever/wow": "workspace:*"
  },
  "devDependencies": {
    "@forever/test-kit": "workspace:*",
    "@forever/wow-types": "workspace:*"
  }
}
